  "backend_gaps": [
    {
      "id": "job_create_response_reference",
      "severity": "required_backend_change",
      "message": "POST /api/jobs/ returns JobCreate, which has no id/state. Return JobDetail or a response containing id, state and created_at."
    },
    {
      "id": "pool_targeting_not_persisted",
      "severity": "required_backend_change",
      "message": "LayerCreate has no target pool field. Maya can read pools and send metadata, but the API contract cannot guarantee pool-based dispatch."
    },
    {
      "id": "missing_start_suspended",
      "severity": "optional_backend_change",
      "message": "JobCreate has no atomic start_suspended field; Maya currently submits then pauses."
    },
    {
      "id": "missing_machine_limit",
      "severity": "optional_backend_change",
      "message": "JobCreate has no machine_limit field; that UI value is metadata only."
    },
    {
      "id": "missing_dependencies",
      "severity": "optional_backend_change",
      "message": "JobCreate has no job dependency field; dependency text is metadata only."
    }
  ]
