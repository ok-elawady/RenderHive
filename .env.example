# --- DATABASE CONFIG ---
POSTGRES_DB=renderhive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/renderhive

# --- REDIS CONFIG ---
REDIS_URL=redis://redis:6379/1

# --- CELERY & BACKGROUND TASKS ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
WORKER_REAP_INTERVAL_SECONDS=15.0
WORKER_STALE_THRESHOLD_SECONDS=30

# --- TELEMETRY & RETENTION ---
TELEMETRY_WORKER_METRIC_INTERVAL_SECONDS=60
TELEMETRY_RETENTION_DAYS=30

# --- DJANGO CONFIG ---
SECRET_KEY=dev-secret-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- DEV SUPERUSER (auto-created on first docker compose up) ---
# Change these before running in a shared or staging environment.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@renderhive.local
DJANGO_SUPERUSER_PASSWORD=admin

# --- FARM AUTHENTICATION ---
# The token used by workers and DCC plugins to authenticate against the API.
# If left blank, a random one is generated and printed to the logs on startup.
# FARM_AGENT_TOKEN=change-me-to-a-secure-random-string

# --- FRONTEND CONFIG ---
# The URL the browser uses to reach the backend API.
# For local dev, leave as localhost. For LAN/staging, use the domain name
# that client machines can resolve (e.g., via the worker installer hosts entry).
# NEXT_PUBLIC_API_URL=http://server.renderhive.local

# --- AI SCHEDULER ---
# Controls the LLM-powered tie-breaker that picks the best task for each worker
# when multiple tasks have very similar base scores. When the AI service is
# unavailable or disabled, dispatch falls back to pure deterministic scoring.
#
# Set SCHEDULER_AI_ENABLED=False to turn off the AI path entirely.
SCHEDULER_AI_ENABLED=True

# URL of the ai_scheduler FastAPI service. Inside Docker Compose this resolves
# automatically via the service name. For local dev outside Docker, point it at
# the running FastAPI server (e.g. http://localhost:8001).
SCHEDULER_AI_URL=http://ai_scheduler:8001/api/v1/rank-tasks

# Seconds to wait for an LLM response before falling back to base scores.
# Increase on slower hardware; decrease if you prefer faster fallbacks.
SCHEDULER_AI_TIMEOUT=5.0

# Absolute path to a GGUF model file loaded by the ai_scheduler service.
# Leave blank to run the service in mock mode (random deltas, useful for dev).
# Example for a lightweight model:
#   LLAMA_MODEL_PATH=/models/mistral-7b-instruct-v0.2.Q4_K_M.gguf
# LLAMA_MODEL_PATH=

# Chat template format for the loaded model. Must match the model family:
#   mistral  — Mistral / Zephyr instruct (default)
#   llama3   — Meta Llama 3 instruct
#   chatml   — ChatML format (Mistral Nemo, Qwen, etc.)
LLAMA_PROMPT_TEMPLATE=mistral

# Build mode for the AI scheduler container:
#   0  — CPU mode (fast ~30s build, works on all machines without GPU setup, default)
#   1  — CUDA mode (downloads Linux Nvidia CUDA runtime wheels for dedicated GPU servers)
AI_USE_CUDA=0

