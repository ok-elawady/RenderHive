# --- DATABASE CONFIG ---
POSTGRES_DB=renderhive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/renderhive

# --- REDIS CONFIG ---
REDIS_URL=redis://redis:6379/1

# --- DJANGO CONFIG ---
SECRET_KEY=dev-secret-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOW_ALL_ORIGINS=True

# --- DEV SUPERUSER (auto-created on first docker compose up) ---
# Change these before running in a shared or staging environment.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@renderhive.local
DJANGO_SUPERUSER_PASSWORD=admin
